{
  "manifest_version": 3,
  "name": "Sauti Adapt (Team 4 Prototype)",
  "description": "Consented personalized speech commands across supported websites, backed by the official AI4A11y Controller.",
  "version": "0.1.0",
  "minimum_chrome_version": "114",
  "action": { "default_title": "Open Sauti Adapt" },
  "permissions": ["sidePanel", "activeTab", "scripting", "storage"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "host_permissions": ["http://localhost:3000/*", "http://127.0.0.1:3000/*", "https://*.vercel.app/*"],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "sidepanel.html" },
  "icons": { "128": "icon.png" }
}
