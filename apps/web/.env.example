SPEECH_API_URL=http://127.0.0.1:8000
SPEECH_API_TOKEN=replace-with-a-service-token
# Browser origins allowed to call this app. Leave empty to allow only the app's own host.
# Add the extension origin, for example chrome-extension://your-extension-id
SAUTI_ALLOWED_ORIGINS=http://localhost:3000

# The published Chrome Web Store URL for Headway, for example:
# NEXT_PUBLIC_HEADWAY_CHROME_WEB_STORE_URL=https://chromewebstore.google.com/detail/headway/abcdefghijklmnopabcdefghijklmnop
# Leave unset until a reviewed Chrome Web Store listing actually exists.

# Independent 32-byte AES cookie key, never reuse SPEECH_API_TOKEN.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SAUTI_SESSION_KEY=
SAUTI_SESSION_KID=v1
# Rotation accepts previous key ids until their 24-hour cookies expire.
SAUTI_SESSION_PREVIOUS_KEYS={}
