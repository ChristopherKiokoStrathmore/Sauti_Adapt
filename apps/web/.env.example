SPEECH_API_URL=http://127.0.0.1:8000
SPEECH_API_TOKEN=replace-with-a-service-token
# Browser origins allowed to call this app. Leave empty to allow only the app's own host.
# Add the extension origin, for example chrome-extension://your-extension-id
SAUTI_ALLOWED_ORIGINS=http://localhost:3000

# The published Chrome Web Store URL for Headway, for example:
