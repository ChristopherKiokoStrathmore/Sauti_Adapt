{
  "name": "sauti-adapt-monorepo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/web",
    "apps/extension",
    "packages/shared"
  ],
  "scripts": {
    "setup:toolkit": "python scripts/bootstrap_toolkit.py",
    "dev:web": "npm run dev --workspace @sauti/web",
    "build:web": "npm run build --workspace @sauti/web",
    "build:extension": "npm run build --workspace @sauti/extension",
    "test:shared": "node --experimental-strip-types --test packages/shared/test/*.test.ts",
    "test:extension": "node --experimental-strip-types --test apps/extension/test/*.test.ts",
    "test:api": "python -m pytest services/speech-api/tests -q",
    "typecheck:web": "npm run typecheck --workspace @sauti/web",
    "typecheck:extension": "tsc --noEmit -p apps/extension/tsconfig.json",
    "test:e2e": "playwright test",
    "check": "npm run test:shared && npm run typecheck:web && npm run typecheck:extension && npm run build:extension && npm run test:api"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/jsdom": "^21.1.7",
    "esbuild": "^0.25.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.0"
  }
}
