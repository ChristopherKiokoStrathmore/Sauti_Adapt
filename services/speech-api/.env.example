SAUTI_API_TOKEN=replace-with-a-strong-private-secret
# HMAC-SHA256 of each person's token, keyed by SAUTI_TOKEN_PEPPER. Not the token itself.
SAUTI_TOKEN_PEPPER=replace-with-another-secret
SAUTI_ACCOUNTS={}
# Fernet key from: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SAUTI_STORAGE_KEY=
SPEECH_MODE=mock
ALLOW_ENROLLMENT=false
SAUTI_RETENTION_DAYS=30
SAUTI_PURGE_INTERVAL_SECONDS=3600
SAUTI_AUTH_FAIL_LIMIT_PER_MINUTE=10
SAUTI_IP_RATE_LIMIT_PER_MINUTE=120
# Must be an absolute directory outside the git clone. The API refuses paths inside the repository.
SAUTI_PRIVATE_DIR=/var/lib/sauti/private
SAUTI_ALLOWED_ORIGINS=
SAUTI_ENCODER_ID=facebook/wav2vec2-base

# Opt-in GPU transcription is comparison-only, never the Controller release gate.
SAUTI_COMPARE_ENABLED=false
SAUTI_MODAL_URL=https://ulla39254--sauti-adapt-cdli-gpu-transcribe.us-east.modal.run
# Set the rotated credential only in Railway environment variables, never Git.
SAUTI_MODAL_BEARER_TOKEN=
# Participant-specific adapters require a verified matching profile ID and consent.
# One pilot participant only. The first account created gets this profile ID automatically.
# Unset it after that person has onboarded. Turn the next line to true only with their consent.
SAUTI_PERSONALIZED_COMPARE_ENABLED=false
SAUTI_PILOT_PROFILE_ID=181959fd-c1b9-40b6-b880-c6d0993f88c7

# ---- Working demo (supervised, with the participant's consent) ----
# SPEECH_MODE=prototype turns on real recognition. mock rejects everything.
# SPEECH_MODE=prototype
# ALLOW_ENROLLMENT=true
# Demo-grade policy: fewer unknown clips needed, release labelled "demo-validation-passed".
# Never present this as a validated release. Turn it off for any real pilot.
# SAUTI_DEMO_MODE=true
# SAUTI_DEMO_MIN_UNKNOWN=10
# SAUTI_DEMO_MAX_UNKNOWN_FAR_UPPER=0.30
# Encoder reading. Layer 8 and silence trimming are the defaults and are NOT VERIFIED on atypical speech.
# Rank layers on the participant's own clips: python -m sauti_ml.layer_sweep --profile-id UUID
# SAUTI_ENCODER_LAYER=8        # 1-12, or "last" for the old behaviour
# SAUTI_ENCODER_TRIM=true
