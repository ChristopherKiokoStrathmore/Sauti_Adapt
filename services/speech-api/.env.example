SAUTI_API_TOKEN=replace-with-a-strong-private-secret
# JSON object of user UUID to sha256 hex of that person's access token. Not the token itself.
SAUTI_ACCOUNTS={}
# Fernet key from: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SAUTI_STORAGE_KEY=
SPEECH_MODE=mock
ALLOW_ENROLLMENT=false
SAUTI_RETENTION_DAYS=30
SAUTI_RATE_LIMIT_PER_MINUTE=30
# Must be an absolute directory outside the git clone. The API refuses paths inside the repository.
SAUTI_PRIVATE_DIR=/var/lib/sauti/private
SAUTI_ALLOWED_ORIGINS=
SAUTI_ENCODER_ID=facebook/wav2vec2-base
